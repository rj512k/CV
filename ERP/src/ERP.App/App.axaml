<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ERP.App.Views"
             xmlns:vms="clr-namespace:ERP.App.ViewModels"
             x:Class="ERP.App.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vms:LoginViewModel}">
      <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ProductsViewModel}">
      <views:ProductsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:CustomersViewModel}">
      <views:CustomersView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:SalesViewModel}">
      <views:SalesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ReportsViewModel}">
      <views:ReportsView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>