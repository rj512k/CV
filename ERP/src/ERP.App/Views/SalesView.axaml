<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP.App.Views.SalesView">
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Sales" FontSize="18" Margin="0,0,0,8"/>
    <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Sales}" AutoGenerateColumns="False" Margin="0,0,8,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
        <DataGridTextColumn Header="Date" Binding="{Binding DateUtc}" Width="180"/>
        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="1" Grid.Column="1" Width="260">
      <TextBlock Text="CustomerId"/>
      <TextBox x:Name="CustomerIdBox"/>
      <TextBlock Text="ProductId" Margin="0,8,0,0"/>
      <TextBox x:Name="ProductIdBox"/>
      <TextBlock Text="Qty" Margin="0,8,0,0"/>
      <TextBox x:Name="QtyBox"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="AddBtn" Content="Add Sale" Width="100"/>
        <Button x:Name="RefreshBtn" Content="Refresh" Width="80" Margin="8,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>